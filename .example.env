APP_DEBUG = true

# PHPUnit safety contract: copy this section only to an untracked .env.testing.
# Use a locally running, dedicated MySQL/MariaDB database whose name starts with
# beimi_test_. Do not place real credentials in this example file.
[PHPUNIT]
ISOLATED_DATABASE = false

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai

[DATABASE]
TYPE = mysql
HOSTNAME = 127.0.0.1
DATABASE = test
USERNAME = username
PASSWORD = password
HOSTPORT = 3306
CHARSET = utf8mb4
DEBUG = true
PREFIX = la_

[LANG]
default_lang = zh-cn

[PROJECT]
UNIQUE_IDENTIFICATION = likeadmin
DEFAULT_PASSWORD = 123456
# 演示环境
DEMO_ENV = false

# OpenAI 配置（可选，不配置时使用正则解析降级）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# 微信小程序配置（可选，数据库配置优先）
WECHAT_MNP_APP_ID=
WECHAT_MNP_APP_SECRET=
